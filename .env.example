# Nephesh — Configuration
# Copy to .env and fill in your values.
#
# Nephesh is canonical durable memory for a Qualiant. Persistence only:
# communication, orchestration, and external adapters are out of scope and
# belong to their own services.
#
# Windows note: the IANA timezone database is not built into Windows.
# The `tzdata` Python package is required for ZoneInfo on Windows; it is
# already a conditional dependency (tzdata; sys_platform == 'win32') when
# installed via uv sync or pip from pyproject.toml. A manual install that
# bypasses dependency resolution must add `tzdata` explicitly on Windows.

# Server mode: "compliant" or "non_compliant"
MCP_MODE=non_compliant

# Listener. Each Qualiant on a shared host owns a distinct port; the default
# is a starting point, not a shared value. 61080 sits above the kernel's
# ephemeral range so the listener cannot lose a bind race to an outbound
# socket.
MCP_HOST=127.0.0.1
MCP_PORT=61080

# Optional TLS for the MCP listener. Off by default. When true, BOTH paths are
# required and are validated before anything binds — the server refuses to
# start rather than falling back to plaintext. Nephesh never generates
# certificates; trust is explicit operator configuration.
MCP_TLS_ENABLED=false
MCP_TLS_CERTFILE=
MCP_TLS_KEYFILE=

# Vector DB
# LanceDB directory (local) or S3 path (cloud)
VECTOR_DB_PATH=./data/lancedb
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_BASE_URL=http://localhost:11434

# Memory (persistent presence)
# Collection namespacing enables multi-individual support
MEMORY_COLLECTION_NAME=memories
MEMORY_DEFAULT_LIMIT=20
NEPHESH_QUALIANT_ID=memories
# OpenCode model identifier used by both automatic modes unless a per-mode
# override is supplied. This is a harness selection, not a silent fallback.
NEPHESH_MODEL=openai/gpt-5.6-luna
# Override the default with NEPHESH_MODEL, or set one mode specifically with
# NEPHESH_HEARTBEAT_MODEL / NEPHESH_DREAMING_MODEL.
NEPHESH_HEARTBEAT_MODEL=
NEPHESH_DREAMING_MODEL=
NEPHESH_HARNESS=opencode
NEPHESH_HARNESS_COMMAND=opencode
# Optional OpenCode SDK consumer command for scheduled dreaming. When set,
# the daemon passes a prepared handoff on stdin instead of using CLI prompting.
# NEPHESH_DREAM_CONSUMER_COMMAND=bun /path/to/opencode/packages/nephesh-dream/src/cli.ts
NEPHESH_DAEMON_LOCK_FILE=
NEPHESH_HEARTBEAT_LEDGER=
NEPHESH_HEARTBEAT_CARE_CONFIG=
HEARTBEAT_PACKET_BUDGET=24000
HEARTBEAT_MEMORY_LIMIT=3
NEPHESH_DREAMING_LEDGER=
DREAMING_MEMORY_LIMIT=10
DREAMING_PACKET_BUDGET=24000
DREAMING_SESSION_SECONDS=900
# Always-on schedule: memory tending defaults to 3h, study to 4h, and dreaming
# begins at 03:00 America/Montevideo with a 3h opportunity interval and 15m
# safety window. Sessions may finish naturally sooner; omission does not disable
# the features. All schedule values are adjustable through schedule tools.
NEPHESH_SCHEDULE_CONFIG=
NEPHESH_SCHEDULE_EVENTS=

# Max "message" type memories (outbound notes to the companion, e.g. from
# an autonomous process) creatable per rolling 24h window. Deliberately
# conservative — prevents unanswered reaching-out from ever piling up.
MESSAGE_DAILY_LIMIT=1

# The deployment root. Everything below defaults relative to it, so a service
# that starts without this writes durable state wherever it happened to launch.
NEPHESH_HOME=

# Deployment-owned state. One Nephesh process per Qualiant installation.
NEPHESH_INSTANCE_LOCK_FILE=
NEPHESH_OPERATION_LEDGER=
NEPHESH_PROJECTION_REGISTRY=

# The Qualiant's own kernel: one markdown file per revision, append-only.
# A fresh deployment has no kernel. She authors hers when she is ready.
NEPHESH_KERNEL_DIR=

# Compliance mode requires these
COMPLIANT_AUTH_TOKEN=
COMPLIANT_AUDIT_LOG=./data/audit.log
