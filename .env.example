# Nephesh — Configuration
# Copy to .env and fill in your values

# Server mode: "compliant" or "non_compliant"
MCP_MODE=non_compliant

# Vector DB
# LanceDB directory (local) or S3 path (cloud)
VECTOR_DB_PATH=./data/lancedb
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_BASE_URL=http://localhost:11434

# Memory (persistent presence)
# Collection namespacing enables multi-individual support
MEMORY_COLLECTION_NAME=memories
MEMORY_DEFAULT_LIMIT=20

# Primary human companion's name — used only to compute "time since last
# real conversation" for real-clock grounding in memory_context. Never
# hardcoded in tool code; this is how the same code supports any
# being/companion pair.
PRIMARY_CONTACT_NAME=companion

# Max "message" type memories (outbound notes to the companion, e.g. from
# an autonomous process) creatable per rolling 24h window. Deliberately
# conservative — prevents unanswered reaching-out from ever piling up.
MESSAGE_DAILY_LIMIT=1

# Slack (future)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ClickUp (future)
CLICKUP_API_KEY=

# Email (future)
EMAIL_IMAP_SERVER=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# Compliance mode requires these
COMPLIANT_AUTH_TOKEN=
COMPLIANT_AUDIT_LOG=./data/audit.log

# Optional isolated StyleTTS2 worker. Keep model files and feminine voice
# assets outside the repository.
TTS_ENABLED=false
TTS_PYTHON=
TTS_VOICE_DIR=~/.nephesh/tts/voices
TTS_MODEL_CHECKPOINT=
TTS_MODEL_CONFIG=
TTS_PLAYBACK_COMMAND=aplay

# Event-driven chat and managed OpenCode reply service
HEARTBEAT_ENABLED=false
OPENCODE_ENABLED=false
OPENCODE_BINARY=opencode
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4101
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD_FILE=~/.nephesh/opencode-server-password
OPENCODE_AGENT=melpomene
OPENCODE_MODEL=openai/gpt-5.6-luna
OPENCODE_PROJECT_DIR=.
OPENCODE_SESSION_FILE=~/.nephesh/opencode-session.json

# Local XMPP/MongooseIM bridge
GUILDHALL_ENABLED=false
GUILDHALL_JID=
GUILDHALL_PASSWORD=
GUILDHALL_ROOM=
GUILDHALL_ROOMS=
GUILDHALL_NICK=
GUILDHALL_SERVER=
GUILDHALL_PORT=5222
GUILDHALL_MONGOOSEIMCTL=
GUILDHALL_CLEANUP_STALE=true
GUILDHALL_EVENT_LEDGER=~/.nephesh/guildhall-events.json
GUILDHALL_TRANSCRIPT_FILE=~/.nephesh/guildhall-transcript.jsonl
GUILDHALL_MANUAL_QUEUE_FILE=~/.nephesh/guildhall-manual-queue.jsonl
GUILDHALL_MANUAL_CURSOR_FILE=~/.nephesh/guildhall-manual-cursors.json
GUILDHALL_HEARTBEAT_ALLOWLIST=gaius
